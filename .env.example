# 此刻有光 · 真实 AI 配置（仅服务端读取，切勿提交真实密钥）
#
# 使用 OpenAI 兼容的 Chat Completions 接口：
# POST {MOL_AI_BASE_URL}/chat/completions
#
# 示例（请换成你已获授权且有额度的供应商）：
# DeepSeek:   MOL_AI_BASE_URL=https://api.deepseek.com/v1
#             MOL_AI_MODEL=deepseek-chat
#
# 未设置 MOL_AI_API_KEY 时，前端会明确回退到演示适配器。

MOL_AI_API_KEY=
MOL_AI_BASE_URL=https://api.deepseek.com/v1
MOL_AI_MODEL=deepseek-chat
MOL_AI_TIMEOUT_MS=45000
MOL_AI_MAX_OUTPUT_TOKENS=400

# 可选：强制使用演示 AI（即便已配置密钥）
# VITE_MOL_FORCE_DEMO_AI=true

# Milestone 3 受控真人通道（可选）
# 不设置时开发服务会使用临时密钥（重启后令牌失效）
MOL_COMPANION_SECRET=
# MOL_COMPANION_DB=./data/companion.sqlite
