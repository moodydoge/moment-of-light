# 此刻有光 · 生产/试运行环境变量模板（勿填入真实密钥后提交）

# --- 服务监听 ---
PORT=8788
MOL_HOST=0.0.0.0

# --- DeepSeek / OpenAI 兼容（仅服务端） ---
MOL_AI_API_KEY=
MOL_AI_BASE_URL=https://api.deepseek.com/v1
MOL_AI_MODEL=deepseek-flash
MOL_AI_TIMEOUT_MS=45000
MOL_AI_MAX_OUTPUT_TOKENS=400

# --- Companion 受控真人 ---
MOL_COMPANION_SECRET=
MOL_COMPANION_DB=./data/companion.sqlite
MOL_COMPANION_ADMIN_TOKEN=
# 生产试运行必须设置：未持邀请码无法签发访客身份（服务端强制）
MOL_COMPANION_INVITE_CODE=

# --- 跨域（仅「静态站与 API 分域」时需要；同源部署可留空） ---
# MOL_CORS_ORIGINS=https://your-workbuddy-host.example

# --- 前端构建期（写入 dist；同源部署请留空） ---
